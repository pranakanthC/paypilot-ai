# PayPal sandbox credentials
# Create them at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# Only change this if you know what you are doing. The app is designed for sandbox.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# OpenAI-compatible LLM endpoint (default runtime: local Ollama with Ministral 3:8b)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=ministral-3:8b

# Optional: where the SQLite database lives
DB_PATH=paypilot.db

# Optional demo helpers (disabled by default; sandbox/development only, not for production)
# Set to 1 to enable approval-gated demo proposal endpoints/UI. Default: disabled.
ENABLE_DEMO_MODE=0
