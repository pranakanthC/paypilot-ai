# PayPal sandbox credentials
# Create them at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Only change this if you know what you are doing. The app is designed for sandbox.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# OpenAI-compatible LLM endpoint (defaults to DeepSeek)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional: where the SQLite database lives
DB_PATH=paypilot.db
